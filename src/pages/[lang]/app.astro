---
import Base from "../../layouts/Base.astro";
import Header from "../../components/landing/Header.astro";
import Footer from "../../components/landing/Footer.astro";
import ExportApp from "../../components/app/ExportApp";
import { getLocaleStaticPaths, getTranslator, type Locale } from "../../i18n";
import { getPublishedGuidesByLocale } from "../../lib/content";
import { buildGuideLinksByTarget } from "../../lib/guides";

export const getStaticPaths = getLocaleStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getTranslator(lang);
const guides = await getPublishedGuidesByLocale(lang);
const guideLinks = buildGuideLinksByTarget(guides);
---

<Base lang={lang} title={`${t("app.title")} · ${t("site.name")}`} path="/app/" noindex>
  <Header lang={lang} path="/app/" />
  <main class="container">
    <ExportApp client:only="react" locale={lang} guideLinks={guideLinks}>
      <p slot="fallback" class="muted">
        {t("app.loading")}
      </p>
    </ExportApp>
  </main>
  <Footer lang={lang} path="/app/" />
</Base>
