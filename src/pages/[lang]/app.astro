---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/landing/Footer.astro";
import ExportApp from "../../components/app/ExportApp";
import { getLocaleStaticPaths, getTranslator, type Locale } from "../../i18n";
import { config } from "../../config";

export const getStaticPaths = getLocaleStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getTranslator(lang);
---

<Base lang={lang} title={`${t("app.title")} · ${t("site.name")}`} path="/app/" noindex>
  <main class="container wide">
    <ExportApp client:only="react" locale={lang} msalConfigured={Boolean(config.msalClientId)}>
      <p slot="fallback" class="muted">
        {t("app.loading")}
      </p>
    </ExportApp>
  </main>
  <Footer lang={lang} path="/app/" />
</Base>
