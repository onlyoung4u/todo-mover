---
import Base from "../../layouts/Base.astro";
import Header from "../../components/landing/Header.astro";
import Footer from "../../components/landing/Footer.astro";
import JsonLd from "../../components/landing/JsonLd.astro";
import { getLocaleStaticPaths, getTranslator, localizedPath, type Locale } from "../../i18n";
import { config } from "../../config";
import { daysUntil } from "../../core/countdown";
import { EXPORTERS, EXPORTER_ORDER } from "../../core/exporters";
import type { ExporterId } from "../../core/exporters/types";
import { getFaqForLocale, getPublishedGuidesByLocale } from "../../lib/content";
import { buildGuideLinksByTarget, findGuideLinkForTargetKey } from "../../lib/guides";
import { buildLandingJsonLd } from "../../lib/jsonld";

export const getStaticPaths = getLocaleStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getTranslator(lang);
const eyebrowTemplate = t("landing.eyebrow");
const appPath = localizedPath(lang, "/app/");
const EXT: Record<ExporterId, string> = {
  json: ".json",
  csv: ".csv",
  markdown: ".md",
  ics: ".ics",
  todoist: "todoist.csv",
  things: "things://",
};
const steps = [t("landing.how.step1"), t("landing.how.step2"), t("landing.how.step3")];

const [guides, faqEntry] = await Promise.all([
  getPublishedGuidesByLocale(lang),
  getFaqForLocale(lang),
]);
const guideLinksByTarget = buildGuideLinksByTarget(guides);
const featuredGuides = guides.slice(0, 4);

const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (p: string) => new URL(p, site).href;
const landingLd = buildLandingJsonLd({
  siteUrl: site.href,
  pageUrl: abs(localizedPath(lang)),
  lang,
  siteName: t("site.name"),
  description: t("site.description"),
  repoUrl: config.repoUrl,
  faqUrl: faqEntry ? abs(localizedPath(lang, "/faq/")) : undefined,
});
---

<Base lang={lang} title={t("site.title")} description={t("site.description")} path="/">
  <Fragment slot="head">
    <JsonLd data={landingLd} />
  </Fragment>
  <Header lang={lang} path="/" />
  <main>
    <section class="container hero">
      <p class="eyebrow">
        <span class="dot"></span>
        <span data-countdown={config.shutdownDate} data-template={eyebrowTemplate}>
          {eyebrowTemplate.replace("{days}", String(daysUntil(config.shutdownDate)))}
        </span>
      </p>
      <h1>{t("landing.headline")}</h1>
      <p class="lead">{t("landing.lead")}</p>

      <div class="window hero-window">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="chip">todo-mover</span>
          <span class="spacer"></span>
          <span class="local">
            <span class="dot"></span>
            {t("landing.local")}
          </span>
        </div>
        <div class="entry-grid">
          <div class="entry primary">
            <h2>{t("app.start.signIn")}</h2>
            <p class="muted">{t("app.start.signInDesc")}</p>
            <div class="entry-action">
              {config.msalClientId ? (
                <a class="button primary" href={`${appPath}?mode=signin`}>
                  {t("landing.signIn")}
                </a>
              ) : (
                <span class="button primary" aria-disabled="true">
                  {t("landing.signIn")}
                </span>
              )}
            </div>
            <div class="entry-foot">
              {!config.msalClientId && <p class="hint">{t("landing.noClientId")}</p>}
            </div>
          </div>
          <div class="entry">
            <h2>{t("app.start.demo")}</h2>
            <p class="muted">{t("app.start.demoDesc")}</p>
            <div class="entry-action">
              <a class="button" href={`${appPath}?mode=demo`}>
                {t("landing.demo")}
              </a>
            </div>
            <div class="entry-foot"></div>
          </div>
          <a class="entry dropzone" href={`${appPath}?mode=import`}>
            <h2>{t("app.start.import")}</h2>
            <p class="muted">{t("app.start.importDesc")}</p>
            <span class="entry-action">
              <span class="chip">todo-backup.json</span>
            </span>
            <span class="entry-foot"></span>
          </a>
        </div>
        <div class="window-foot">
          <span>{t("landing.windowFoot")}</span>
          <span class="spacer"></span>
          <span class="ext-chips">
            {EXPORTER_ORDER.map((id) => (
              <span class="chip">{EXT[id]}</span>
            ))}
          </span>
        </div>
      </div>
    </section>

    <section class="container section" aria-labelledby="how-heading">
      <p class="eyebrow">{t("landing.how.eyebrow")}</p>
      <h2 id="how-heading">{t("landing.how.heading")}</h2>
      <ol class="steps">
        {steps.map((text, i) => (
          <li class="card">
            <span class="eyebrow">
              {t("landing.stepLabel", { n: String(i + 1).padStart(2, "0") })}
            </span>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container section" id="formats" aria-labelledby="formats-heading">
      <p class="eyebrow">{t("landing.formats.eyebrow")}</p>
      <h2 id="formats-heading">{t("landing.formats.heading")}</h2>
      <ul class="formats">
        {EXPORTER_ORDER.map((id) => {
          const guideHref = findGuideLinkForTargetKey(guideLinksByTarget, id);
          return (
            <li class="card">
              <div class="format-head">
                <h3>{t(EXPORTERS[id].label)}</h3>
                <span class="chip accent">{EXT[id]}</span>
              </div>
              <p>{t(EXPORTERS[id].targets)}</p>
              <p class="loss">
                <span class="loss-label">{t("app.formats.losses")}</span> {t(EXPORTERS[id].losses)}
              </p>
              {guideHref && (
                <a class="format-guide-link" href={guideHref}>
                  {t("landing.formats.readGuide")} →
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </section>

    {(featuredGuides.length > 0 || faqEntry) && (
      <section class="container section" id="guides" aria-labelledby="guides-heading">
        <div class="guides-head">
          <div>
            <p class="eyebrow">{t("landing.guides.eyebrow")}</p>
            <h2 id="guides-heading">{t("landing.guides.heading")}</h2>
          </div>
          <div class="guides-actions">
            <a class="button small" href={localizedPath(lang, "/guides/")}>
              {t("landing.guides.all")}
            </a>
            {faqEntry && (
              <a class="button small" href={localizedPath(lang, "/faq/")}>
                {t("landing.guides.faq")}
              </a>
            )}
          </div>
        </div>
        {featuredGuides.length > 0 && (
          <ul class="featured-guides">
            {featuredGuides.map((guide) => (
              <li>
                <a
                  class="card featured-guide-card"
                  href={localizedPath(lang, `/guides/${guide.slug}/`)}
                >
                  <h3>{guide.data.title}</h3>
                  <p>{guide.data.description}</p>
                  <span class="featured-guide-more">{t("guides.read")} →</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <section class="container section two-col" id="privacy">
      <div class="card">
        <p class="eyebrow">{t("landing.privacyDetails.eyebrow")}</p>
        <h2>{t("landing.privacyDetails.heading")}</h2>
        <p>{t("landing.privacyDetails.body")}</p>
        {
          // SPEC 9 / 15.6：启用 Cloudflare Web Analytics 时必须在隐私说明中写明
          config.cfAnalyticsToken && <p>{t("landing.privacyDetails.analytics")}</p>
        }
        <p>
          <a href={localizedPath(lang, "/privacy/")}>{t("landing.privacyDetails.more")} →</a>
        </p>
      </div>
      <div class="card">
        <p class="eyebrow">{t("landing.limits.eyebrow")}</p>
        <h2>{t("landing.limits.heading")}</h2>
        <p>{t("app.limits.text")}</p>
      </div>
    </section>
  </main>
  <Footer lang={lang} path="/" />
  <script>
    import "../../scripts/countdown";
  </script>
</Base>

<style>
  .hero {
    padding-top: 72px;
  }
  .hero h1 {
    max-width: 16em;
  }
  .lead {
    max-width: 40em;
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 36px;
  }
  .hero-window {
    margin-top: 8px;
  }
  .ext-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .section {
    margin-top: 96px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .steps p {
    margin: 0;
  }
  .formats {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .formats li {
    display: flex;
    flex-direction: column;
  }
  .format-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .format-head h3 {
    margin: 0 0 8px;
  }
  .formats p {
    margin: 0 0 8px;
  }
  .loss {
    margin-top: auto !important;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .loss .loss-label {
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: var(--font-label-weight);
    color: var(--subtle);
    margin-right: 4px;
  }
  .format-guide-link {
    margin-top: 10px;
    font-size: 0.85rem;
    font-weight: 550;
    text-decoration: none;
  }
  .format-guide-link:hover {
    text-decoration: underline;
  }
  .guides-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 20px;
  }
  .guides-head h2 {
    margin-bottom: 0;
  }
  .guides-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .featured-guides {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .featured-guide-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .featured-guide-card:hover {
    border-color: var(--accent);
    color: inherit;
    box-shadow: var(--shadow);
  }
  .featured-guide-card h3 {
    font-family: var(--font-card-heading);
    margin: 0 0 8px;
  }
  .featured-guide-card p {
    margin: 0 0 14px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .featured-guide-more {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--accent);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .two-col h2 {
    font-size: 1.4rem;
  }
  .two-col p:last-child {
    margin: 0;
  }
  @media (max-width: 820px) {
    .steps,
    .two-col {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-top: 40px;
    }
  }
</style>
