---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/landing/Footer.astro";
import { getLocaleStaticPaths, getTranslator, localizedPath, type Locale } from "../../i18n";
import { config } from "../../config";
import { daysUntil } from "../../core/countdown";

export const getStaticPaths = getLocaleStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getTranslator(lang);
const countdownTemplate = t("landing.countdown");
const appPath = localizedPath(lang, "/app/");
---

<Base lang={lang} title={t("site.title")} description={t("site.description")} path="/">
  <main class="container hero">
    <p class="news">
      {t("landing.news")}
      <strong data-countdown={config.shutdownDate} data-template={countdownTemplate}>
        {countdownTemplate.replace("{days}", String(daysUntil(config.shutdownDate)))}
      </strong>
    </p>
    <h1>{t("landing.headline")}</h1>
    <p class="muted">{t("landing.privacy")}</p>

    <div class="actions">
      {config.msalClientId ? (
        <a class="button primary" href={`${appPath}?mode=signin`}>
          {t("landing.signIn")}
        </a>
      ) : (
        <span class="button primary" aria-disabled="true" title={t("landing.noClientId")}>
          {t("landing.signIn")}
        </span>
      )}
      <a class="button" href={`${appPath}?mode=demo`}>
        {t("landing.demo")}
      </a>
      <a class="button" href={`${appPath}?mode=import`}>
        {t("landing.importJson")}
      </a>
    </div>
    {!config.msalClientId && <p class="muted">{t("landing.noClientId")}</p>}
  </main>
  <Footer lang={lang} path="/" />
  <script>
    import "../../scripts/countdown";
  </script>
</Base>

<style>
  .hero {
    padding-top: 64px;
  }
  .news {
    padding: 12px 16px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
</style>
