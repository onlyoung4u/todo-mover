---
import Base from "../layouts/Base.astro";
import Logo from "../components/landing/Logo.astro";
import { LOCALES, LOCALE_NAMES, MESSAGES, localizedPath } from "../i18n";

const site = Astro.site ?? new URL(Astro.url.origin);
---

<Base title={MESSAGES.en["site.title"]} description={MESSAGES.en["site.description"]}>
  <Fragment slot="head">
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizedPath(l), site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
  </Fragment>
  <main class="container gate">
    <div class="window gate-card">
      <div class="window-bar">
        <span class="window-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="chip">todo-mover</span>
      </div>
      <div class="gate-body">
        <div class="gate-brand">
          <Logo size={34} />
          <h1>{MESSAGES.en["site.name"]}</h1>
        </div>
        <ul class="gate-list">
          {LOCALES.map((l) => (
            <li>
              <a class="gate-link" href={localizedPath(l)} hreflang={l} lang={l} data-locale={l}>
                <span class="gate-name">{LOCALE_NAMES[l]}</span>
                <span class="muted">{MESSAGES[l]["root.choose"]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>
  <script>
    import "../scripts/locale-switch";
    import "../scripts/root-redirect";
  </script>
</Base>

<style>
  .gate {
    display: grid;
    place-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .gate-card {
    width: 100%;
    max-width: 480px;
  }
  .gate-body {
    padding: 28px 24px;
  }
  .gate-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .gate-brand h1 {
    font-size: 1.5rem;
    margin: 0;
  }
  .gate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gate-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .gate-link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--fg);
  }
  .gate-name {
    font-weight: 600;
  }
</style>
