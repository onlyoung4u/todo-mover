---
import "../styles/global.css";
import { LOCALES, type Locale } from "../i18n";
import { config } from "../config";

interface Props {
  /** 当前页面语言；不传表示与语言无关的页面（根跳转页、404、登录回调）。 */
  lang?: Locale;
  title: string;
  description?: string;
  /** 不含语言前缀的页面路径，例如 "/" 或 "/app/"；用于生成 canonical 和 hreflang。 */
  path?: string;
  noindex?: boolean;
}

const { lang, title, description, path, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (p: string) => new URL(p, site).href;

const canonical = lang && path ? abs(`/${lang}${path}`) : abs(Astro.url.pathname);
const alternates =
  lang && path ? LOCALES.map((l) => ({ hreflang: l, href: abs(`/${l}${path}`) })) : [];
---

<!doctype html>
<html lang={lang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 同步执行：在绘制前应用用户选择的浅色 / 深色主题 -->
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={abs("/")} />}
    <slot name="head" />
    {config.cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: config.cfAnalyticsToken })}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
