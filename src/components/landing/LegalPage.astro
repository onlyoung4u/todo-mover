---
import Base from "../../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../../styles/content.css";
import { getTranslator, localizedPath, type Locale } from "../../i18n";
import { config } from "../../config";
import { LEGAL_UPDATED, type LegalDoc } from "../../legal/types";
import { visibleSections } from "../../legal";

interface Props {
  lang: Locale;
  /** 不含语言前缀的页面路径："/privacy/" 或 "/terms/"。 */
  path: string;
  doc: LegalDoc;
}

const { lang, path, doc } = Astro.props;
const t = getTranslator(lang);
const sections = visibleSections(doc, {
  analytics: Boolean(config.cfAnalyticsToken),
  donate: Boolean(config.donateUrlCn || config.donateUrlGlobal),
});
---

<Base
  lang={lang}
  title={`${doc.title} · ${t("site.name")}`}
  description={doc.description}
  path={path}
>
  <Header lang={lang} path={path} />
  <main class="container content-page">
    <article class="content-measure">
      <nav class="breadcrumb" aria-label={t("breadcrumb.label")}>
        <ol>
          <li>
            <a href={localizedPath(lang)}>{t("breadcrumb.home")}</a>
          </li>
          <li aria-current="page">{doc.title}</li>
        </ol>
      </nav>

      <h1>{doc.title}</h1>
      <p class="content-lead">{doc.lead}</p>
      <div class="meta-row">
        <span>
          <time datetime={LEGAL_UPDATED}>{t("legal.updated", { date: LEGAL_UPDATED })}</time>
        </span>
      </div>

      <div class="prose">
        {sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.blocks.map((block) =>
              "p" in block ? (
                <p>{block.p}</p>
              ) : "list" in block ? (
                <ul>
                  {block.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <ul>
                  {block.links.map((link) => (
                    <li>
                      <a href={link.href} rel="noopener">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ),
            )}
            {section.contact && (
              <ul>
                {config.contactEmail && (
                  <li>
                    <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a>
                  </li>
                )}
                <li>
                  <a href={`${config.repoUrl}/issues`} rel="noopener">
                    {t("legal.contactIssues")}
                  </a>
                </li>
              </ul>
            )}
          </section>
        ))}
      </div>
    </article>
  </main>
  <Footer lang={lang} path={path} />
</Base>
