---
import Logo from "./Logo.astro";
import {
  LOCALES,
  LOCALE_NAMES,
  getTranslator,
  localeSwitchPath,
  localizedPath,
  type Locale,
} from "../../i18n";
import { authorUrlFor, config, donateUrlFor } from "../../config";

interface Props {
  lang: Locale;
  /** 不含语言前缀的当前页面路径，用于语言切换后停留在同一页面。 */
  path: string;
  /** 当前页面实际存在的语言；目标语言缺失时切到 fallbackPath。 */
  availableLocales?: readonly Locale[];
  /** 目标语言缺失当前页时的回退路径（不含语言前缀），如 "/guides/"。 */
  fallbackPath?: string;
}

const { lang, path, availableLocales, fallbackPath } = Astro.props;
const t = getTranslator(lang);
const donateUrl = donateUrlFor(lang);
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand small" href={localizedPath(lang)}>
        <Logo size={22} />
        <span>{t("site.name")}</span>
      </a>
      <nav class="links">
        <a
          href={localizedPath(lang, "/guides/")}
          aria-current={path.startsWith("/guides/") ? "page" : undefined}
        >
          {t("nav.guides")}
        </a>
        <a href={localizedPath(lang, "/faq/")} aria-current={path === "/faq/" ? "page" : undefined}>
          {t("nav.faq")}
        </a>
        <a
          href={localizedPath(lang, "/privacy/")}
          aria-current={path === "/privacy/" ? "page" : undefined}
        >
          {t("footer.privacy")}
        </a>
        <a
          href={localizedPath(lang, "/terms/")}
          aria-current={path === "/terms/" ? "page" : undefined}
        >
          {t("footer.terms")}
        </a>
        <a href={config.repoUrl} rel="noopener">
          {t("footer.source")}
        </a>
        {donateUrl && (
          <a href={donateUrl} rel="noopener">
            {t("footer.donate")}
          </a>
        )}
        <span class="locales" aria-label={t("footer.language")}>
          {LOCALES.map((l) => (
            <a
              href={localeSwitchPath(l, path, availableLocales, fallbackPath)}
              hreflang={l}
              lang={l}
              data-locale={l}
              aria-current={l === lang ? "page" : undefined}
            >
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </span>
      </nav>
    </div>
    <p class="disclaimer">{t("footer.disclaimer")}</p>
    <p class="license">
      AGPL-3.0 · {t("footer.local")} ·{" "}
      <a href={authorUrlFor(lang)}>{t("footer.madeBy", { name: "Alchemew" })}</a>
    </p>
  </div>
</footer>

<script>
  import "../../scripts/locale-switch";
</script>

<style>
  .footer {
    margin-top: 96px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .brand.small {
    font-size: 1rem;
  }
  .links,
  .locales {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--fg);
  }
  .locales a[aria-current="page"] {
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .disclaimer {
    max-width: 640px;
    margin: 0 0 8px;
  }
  .license {
    font-family: var(--font-label);
    font-variant-numeric: tabular-nums;
    font-size: var(--font-label-size);
    color: var(--subtle);
    margin: 0;
  }
  .license a {
    color: inherit;
  }
  .license a:hover {
    color: var(--fg);
  }
</style>
