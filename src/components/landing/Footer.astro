---
import Logo from "./Logo.astro";
import { LOCALES, LOCALE_NAMES, getTranslator, localizedPath, type Locale } from "../../i18n";
import { config, donateUrlFor } from "../../config";

interface Props {
  lang: Locale;
  /** 不含语言前缀的当前页面路径，用于语言切换后停留在同一页面。 */
  path: string;
}

const { lang, path } = Astro.props;
const t = getTranslator(lang);
const donateUrl = donateUrlFor(lang);
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand small" href={localizedPath(lang)}>
        <Logo size={22} />
        <span>{t("site.name")}</span>
      </a>
      <nav class="links">
        <a href={config.repoUrl} rel="noopener">
          {t("footer.source")}
        </a>
        {donateUrl && (
          <a href={donateUrl} rel="noopener">
            {t("footer.donate")}
          </a>
        )}
        <span class="locales" aria-label={t("footer.language")}>
          {LOCALES.map((l) => (
            <a
              href={localizedPath(l, path)}
              hreflang={l}
              lang={l}
              data-locale={l}
              aria-current={l === lang ? "page" : undefined}
            >
              {LOCALE_NAMES[l]}
            </a>
          ))}
        </span>
      </nav>
    </div>
    <p class="disclaimer">{t("footer.disclaimer")}</p>
    <p class="license mono">AGPL-3.0 · {t("footer.local")}</p>
  </div>
</footer>

<script>
  import "../../scripts/locale-switch";
</script>

<style>
  .footer {
    margin-top: 96px;
    padding: 32px 0 40px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .brand.small {
    font-size: 1rem;
  }
  .links,
  .locales {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover {
    color: var(--fg);
  }
  .locales a[aria-current="page"] {
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .disclaimer {
    max-width: 640px;
    margin: 0 0 8px;
  }
  .license {
    font-size: 0.75rem;
    color: var(--subtle);
    margin: 0;
  }
  :global(:lang(zh)) .license {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
</style>
