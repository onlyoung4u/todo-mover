# 复制为 .env.local 后填写。这些值会被打包进前端 JS，本来就是公开的，不是秘密。
# 每个环境（预发 / 正式）需要用各自的值单独构建一次。

# Azure 应用的 Application (client) ID。留空时站点照常构建，只能使用演示模式。
PUBLIC_MSAL_CLIENT_ID=

# 正式域名，用于 canonical、hreflang、sitemap。留空时默认 http://localhost:4321
PUBLIC_SITE_URL=

# 打赏链接：简体中文界面显示 CN，其他语言显示 GLOBAL
PUBLIC_DONATE_URL_CN=
PUBLIC_DONATE_URL_GLOBAL=

# 可选：Cloudflare Web Analytics 令牌
PUBLIC_CF_ANALYTICS_TOKEN=

# 设为 true 时开启整站防收录（预发与 PR 预览环境使用）：
# 页面输出 noindex, nofollow 且省略 canonical/hreflang；robots.txt 省略 Sitemap；
# 跳过生成 sitemap-*.xml 与 llms*.txt，并在 dist/_headers 的 /* 下追加 X-Robots-Tag。
PUBLIC_NOINDEX=
