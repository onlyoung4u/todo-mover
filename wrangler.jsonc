{
  // 纯静态资源托管：只配置 assets，不配置 main（没有 Worker 脚本，静态请求不计入调用次数）。见 SPEC 第 15 节。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "todo-mover",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // 正式环境只通过自定义域名访问：*.workers.dev 在中国大陆无法访问，且会造成重复收录
  "workers_dev": false,
  // 自部署模板占位域名（DNS 需托管在 Cloudflare）；官方站点由私有内容仓库的 deploy/wrangler.jsonc 覆盖
  "routes": [{ "pattern": "todo-mover.example.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "todo-mover-staging",
      "workers_dev": true,
      // 用一级子域名：Universal SSL 只覆盖 *.<域名>，staging.todo-mover.<域名> 这类多级子域名不在其内
      "routes": [{ "pattern": "todo-mover-staging.example.com", "custom_domain": true }],
    },
  },
}
